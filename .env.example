# Copy to .env and fill in. .env is gitignored. Never commit a real key.
# Leave MODEL_API_KEY empty to run entirely on the offline FakeModel.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
# Standard mode only. Never use a "-contributor" model (Meta may train on prompts).
MODEL_NAME=muse-spark-1.3
# fake | meta
AIRGAP_PROVIDER=fake
