# Copy to .env and fill in. .env is gitignored. Never commit a real key.
# The offline FakeLLM is the default (`--provider fake`) and needs no key.
# MODEL_API_KEY is used only with `--provider meta`.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
# Standard mode only. Never use a "-contributor" model (Meta may train on prompts).
MODEL_NAME=muse-spark-1.3
# Optional: low | medium | high. muse-spark-1.3 spends output tokens thinking, and a long think can
# use the whole 2048-token limit and leave no answer. Try `low` if the planner returns nothing.
MODEL_REASONING_EFFORT=low
